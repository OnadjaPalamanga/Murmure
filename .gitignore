# --- Environments and dependencies ---
backend/.venv/
frontend/node_modules/
# Genere par `uv run`, mais jamais lu : l'installation passe par
# `uv pip install -e .`, qui ignore le verrou. Le committer figerait des roues
# CUDA resolues sur une seule machine, dans un fichier que rien ne consulte.
#
# La contrepartie est assumee : la pile d'EXECUTION n'est pas reproductible au
# paquet pres, parce qu'elle depend du GPU de la machine. Ce qui doit l'etre
# l'est — `backend/requirements-ci.txt` epingle tout ce que la CI installe, et
# `Cargo.lock` comme `package-lock.json` sont versionnes.
uv.lock

__pycache__/
*.egg-info/
*.pyc

# --- Build artifacts ---
frontend/src-tauri/target/
frontend/src-tauri/gen/

# --- Downloaded models (several GB) ---
# Note the `models/*` form: git does not descend into an excluded directory,
# so `models/` followed by `!models/.gitkeep` would never un-ignore anything.
models/*
!models/.gitkeep

# --- External binaries (ffmpeg is ~80 MB) ---
bin/*
!bin/.gitkeep

# --- Local and personal data ---
*.db
*.db-shm
*.db-wal
*.log
recordings/

# --- Tool caches ---
.ruff_cache/
.pytest_cache/
.mypy_cache/

# --- Editors and OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
*~

# --- Scratch files ---
*.tmp
scratch/
