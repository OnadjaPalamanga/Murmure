# --- Environments and dependencies ---
backend/.venv/
frontend/node_modules/
__pycache__/
*.egg-info/
*.pyc

# --- Build artifacts ---
frontend/src-tauri/target/
frontend/src-tauri/gen/

# --- Downloaded models (several GB) ---
# Note the `models/*` form: git does not descend into an excluded directory,
# so `models/` followed by `!models/.gitkeep` would never un-ignore anything.
models/*
!models/.gitkeep

# --- External binaries (ffmpeg is ~80 MB) ---
bin/*
!bin/.gitkeep

# --- Local and personal data ---
*.db
*.db-shm
*.db-wal
*.log
recordings/

# --- Tool caches ---
.ruff_cache/
.pytest_cache/
.mypy_cache/

# --- Editors and OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
*~

# --- Scratch files ---
*.tmp
scratch/
