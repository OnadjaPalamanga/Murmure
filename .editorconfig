# https://editorconfig.org — keeps the four languages of this repo consistent
# without anyone having to configure their editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

# Windows-native tooling: must keep CRLF, matching .gitattributes.
[*.{ps1,cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
